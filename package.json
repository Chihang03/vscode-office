{
	"name": "kieran-document-studio",
	"displayName": "Kieran Document Studio（文档工作台）",
	"description": "Kieran Dai 独立维护的社区 fork：在 VS Code 中查看办公文档、编辑 Markdown，并浏览 Git 历史。",
	"version": "0.1.5",
	"publisher": "chihang03",
	"icon": "image/kieran-document-studio.png",
	"engines": {
		"vscode": "^1.64.0",
		"node": ">=22.12.0"
	},
	"keywords": [
		"pdf",
		"word",
		"docx",
		"excel",
		"xlsx",
		"csv",
		"tsv",
		"powerpoint",
		"pptx",
		"markdown",
		"epub",
		"svg",
		"psd",
		"xmind",
		"parquet",
		"zip",
		"archive",
		"font",
		"toml",
		"yaml",
		"xml",
		"git",
		"git-history",
		"audio",
		"wav",
		"waveform"
	],
	"categories": [
		"Visualization",
		"Other"
	],
	"bugs": {
		"url": "https://github.com/Chihang03/vscode-office/issues"
	},
	"homepage": "https://github.com/Chihang03/vscode-office",
	"repository": {
		"type": "git",
		"url": "https://github.com/Chihang03/vscode-office.git"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"browser": "./out/extension.web.js",
	"contributes": {
		"themes": [
			{
				"label": "One Dark Modern (Kieran Document Studio)",
				"uiTheme": "vs-dark",
				"path": "./theme/onedark-modern.json"
			},
			{
				"label": "One Dark Modern Classic (Kieran Document Studio)",
				"uiTheme": "vs-dark",
				"path": "./theme/onedark-modern-classic.json"
			}
		],
		"iconThemes": [
			{
				"id": "kieran-document-studio-material-icons",
				"label": "Material Icons (Kieran Document Studio)",
				"path": "./theme/material-icons.json",
				"_watch": true
			}
		],
		"languages": [
			{
				"id": "nginx",
				"aliases": [
					"NGINX Conf",
					"NGINX",
					"nginx"
				],
				"extensions": [
					".conf",
					".conf.default",
					".conf.template",
					"mime.types",
					"fastcgi_params",
					"scgi_params",
					"uwsgi_params",
					"nginx.conf",
					".nginx"
				],
				"configuration": "./syntaxes/nginx.configuration.json"
			},
			{
				"id": "kotlin",
				"aliases": [
					"Kotlin"
				],
				"extensions": [
					".kt",
					".kts"
				],
				"configuration": "./syntaxes/kotlin-language-configuration.json"
			},
			{
				"id": "reg",
				"aliases": [
					"REG",
					"reg"
				],
				"extensions": [
					".reg",
					".REG"
				],
				"configuration": "./syntaxes/reg-language-configuration.json"
			},
			{
				"id": "http",
				"aliases": [
					"HTTP",
					"Http",
					"http"
				],
				"extensions": [
					".http",
					".rest"
				],
				"firstLine": "^(GET|POST|PUT|DELETE|PATCH|HEAD|OPTIONS|CONNECT|TRACE)\\s+(.*?)HTTP/[0-9\\.]+$",
				"configuration": "./syntaxes/http-language-configuration.json"
			},
			{
				"id": "toml",
				"aliases": [
					"TOML",
					"Toml",
					"toml"
				],
				"extensions": [
					".toml"
				],
				"configuration": "./syntaxes/toml-language-configuration.json"
			},
			{
				"id": "kusto",
				"aliases": [
					"Kusto",
					"kusto",
					"KQL",
					"kql"
				],
				"extensions": [
					".csl",
					".kusto",
					".kql"
				],
				"configuration": "./syntaxes/kusto-language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "nginx",
				"scopeName": "source.nginx",
				"path": "./syntaxes/nginx.tmLanguage",
				"embeddedLanguages": {
					"meta.embedded.block.lua": "lua"
				}
			},
			{
				"language": "kotlin",
				"scopeName": "source.kotlin",
				"path": "./syntaxes/kotlin.tmLanguage.json"
			},
			{
				"language": "reg",
				"scopeName": "source.reg",
				"path": "./syntaxes/reg.tmLanguage"
			},
			{
				"language": "http",
				"scopeName": "source.http",
				"path": "./syntaxes/http.tmLanguage.json"
			},
			{
				"language": "toml",
				"scopeName": "source.toml",
				"path": "./syntaxes/toml.tmLanguage.json"
			},
			{
				"language": "kusto",
				"scopeName": "source.kusto",
				"path": "./syntaxes/kusto.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "http",
				"path": "./snippets/http.json"
			}
		],
		"commands": [
			{
				"command": "kieranDocumentStudio.save-response-body",
				"title": "Save Response",
				"icon": "$(save)",
				"enablement": "!kieranDocumentStudio.extensionHost.web",
				"category": "Kieran Document Studio"
			},
			{
				"command": "kieranDocumentStudio.copy-response-body",
				"title": "Copy Response",
				"icon": "$(copy)",
				"enablement": "!kieranDocumentStudio.extensionHost.web",
				"category": "Kieran Document Studio"
			},
			{
				"command": "kieranDocumentStudio.markdown.switch",
				"title": "Switch markdown editor",
				"icon": "$(edit)",
				"category": "Kieran Document Studio"
			},
			{
				"command": "kieranDocumentStudio.csv.switch",
				"title": "Switch CSV editor",
				"icon": "$(edit)",
				"category": "Kieran Document Studio"
			},
			{
				"command": "kieranDocumentStudio.markdown.paste",
				"title": "Enhance paste in markdown",
				"enablement": "!kieranDocumentStudio.extensionHost.web",
				"category": "Kieran Document Studio"
			},
			{
				"command": "kieranDocumentStudio.html.preview",
				"title": "Preview HTML",
				"category": "Kieran Document Studio"
			},
			{
				"command": "kieranDocumentStudio.gitHistory.view",
				"title": "View Git History",
				"icon": "$(history)",
				"enablement": "!kieranDocumentStudio.extensionHost.web",
				"category": "Kieran Document Studio"
			},
			{
				"command": "kieranDocumentStudio.gitHistory.viewFileHistory",
				"title": "Git: View File History",
				"icon": "$(git-commit)",
				"enablement": "!kieranDocumentStudio.extensionHost.web",
				"category": "Kieran Document Studio"
			},
			{
				"command": "kieranDocumentStudio.gitHistory.quickSync",
				"title": "Git: Quick Sync",
				"icon": "$(sync)",
				"enablement": "!kieranDocumentStudio.extensionHost.web",
				"category": "Kieran Document Studio"
			},
			{
				"command": "kieranDocumentStudio.markdown.exportPdf",
				"title": "%ext.markdown.exportPdf%",
				"category": "Kieran Document Studio",
				"icon": "$(export)",
				"enablement": "!kieranDocumentStudio.extensionHost.web"
			}
		],
		"keybindings": [
			{
				"command": "kieranDocumentStudio.markdown.paste",
				"key": "ctrl+v",
				"mac": "cmd+v",
				"when": "editorTextFocus && resourceLangId == markdown && !kieranDocumentStudio.extensionHost.web"
			},
			{
				"command": "kieranDocumentStudio.html.preview",
				"key": "ctrl+shift+v",
				"when": "editorTextFocus && editorLangId == html"
			},
			{
				"command": "kieranDocumentStudio.markdown.switch",
				"key": "ctrl+alt+e",
				"mac": "ctrl+cmd+e",
				"when": "editorTextFocus && editorLangId == markdown"
			},
			{
				"command": "kieranDocumentStudio.request",
				"key": "ctrl+enter",
				"mac": "cmd+enter",
				"when": "editorTextFocus && editorLangId == 'http' && !kieranDocumentStudio.extensionHost.web"
			}
		],
		"menus": {
			"scm/title": [
				{
					"command": "kieranDocumentStudio.gitHistory.view",
					"group": "navigation",
					"when": "scmProvider == git && !kieranDocumentStudio.extensionHost.web"
				},
				{
					"command": "kieranDocumentStudio.gitHistory.quickSync",
					"group": "navigation",
					"when": "scmProvider == git && config.kieran-document-studio.gitHistory.quickSyncButton && !kieranDocumentStudio.extensionHost.web"
				}
			],
			"scm/repository": [
				{
					"command": "kieranDocumentStudio.gitHistory.view",
					"group": "navigation",
					"when": "scmProvider == git && !kieranDocumentStudio.extensionHost.web"
				}
			],
			"scm/resourceState/context": [
				{
					"command": "kieranDocumentStudio.gitHistory.viewFileHistory",
					"when": "config.git.enabled && gitOpenRepositoryCount != 0 && !kieranDocumentStudio.extensionHost.web"
				}
			],
			"editor/title": [
				{
					"command": "kieranDocumentStudio.gitHistory.viewFileHistory",
					"group": "navigation@4",
					"when": "config.git.enabled && gitOpenRepositoryCount != 0 && resourceScheme == file && !kieranDocumentStudio.extensionHost.web"
				},
				{
					"command": "kieranDocumentStudio.markdown.switch",
					"when": "resourceExtname == '.md'",
					"group": "navigation@-2"
				},
				{
					"command": "kieranDocumentStudio.csv.switch",
					"when": "resourceExtname == '.csv' || resourceExtname == '.tsv'",
					"group": "navigation@-2"
				},
				{
					"when": "editorTextFocus && resourceScheme == kieran-document-studio-response",
					"command": "kieranDocumentStudio.copy-response-body",
					"group": "navigation@0"
				},
				{
					"when": "editorTextFocus && resourceScheme == kieran-document-studio-response",
					"command": "kieranDocumentStudio.save-response-body",
					"group": "navigation@2"
				},
				{
					"command": "kieranDocumentStudio.markdown.exportPdf",
					"when": "resourceScheme == file && (resourceExtname == .md || resourceExtname == .markdown) && !kieranDocumentStudio.extensionHost.web",
					"group": "navigation@5"
				}
			],
			"editor/context": [
				{
					"command": "kieranDocumentStudio.gitHistory.viewFileHistory",
					"group": "git",
					"when": "config.git.enabled && gitOpenRepositoryCount != 0 && resourceScheme == file && !kieranDocumentStudio.extensionHost.web"
				},
				{
					"command": "kieranDocumentStudio.html.preview",
					"group": "navigation@1",
					"when": "editorTextFocus && editorLangId == html"
				},
				{
					"command": "kieranDocumentStudio.save-response-body",
					"group": "http@2",
					"when": "editorTextFocus && resourceScheme == kieran-document-studio-response && !kieranDocumentStudio.extensionHost.web"
				},
				{
					"command": "kieranDocumentStudio.copy-response-body",
					"group": "http@4",
					"when": "editorTextFocus && resourceScheme == kieran-document-studio-response && !kieranDocumentStudio.extensionHost.web"
				},
				{
					"command": "kieranDocumentStudio.markdown.exportPdf",
					"when": "resourceScheme == file && (resourceExtname == .md || resourceExtname == .markdown) && !kieranDocumentStudio.extensionHost.web",
					"group": "kieranDocumentStudio@1"
				}
			],
			"explorer/context": [
				{
					"command": "kieranDocumentStudio.gitHistory.viewFileHistory",
					"group": "git",
					"when": "config.git.enabled && gitOpenRepositoryCount != 0 && resourceScheme == file && !kieranDocumentStudio.extensionHost.web"
				},
				{
					"command": "kieranDocumentStudio.markdown.exportPdf",
					"when": "resourceScheme == file && (resourceExtname == .md || resourceExtname == .markdown) && !kieranDocumentStudio.extensionHost.web",
					"group": "kieranDocumentStudio@1"
				}
			],
			"commandPalette": [
				{
					"command": "kieranDocumentStudio.markdown.exportPdf",
					"when": "!kieranDocumentStudio.extensionHost.web"
				}
			]
		},
		"customEditors": [
			{
				"viewType": "kieranDocumentStudio.officeViewer",
				"displayName": "Kieran Document Studio: Documents",
				"selector": [
					{
						"filenamePattern": "*.xls"
					},
					{
						"filenamePattern": "*.xlsx"
					},
					{
						"filenamePattern": "*.xlsm"
					},
					{
						"filenamePattern": "file:/**/*.csv"
					},
					{
						"filenamePattern": "vscode-vfs:/**/*.csv"
					},
					{
						"filenamePattern": "vscode-remote:/**/*.csv"
					},
					{
						"filenamePattern": "*.tsv"
					},
					{
						"filenamePattern": "*.ods"
					},
					{
						"filenamePattern": "file:/**/*.docx"
					},
					{
						"filenamePattern": "vscode-vfs:/**/*.docx"
					},
					{
						"filenamePattern": "vscode-remote:/**/*.docx"
					},
					{
						"filenamePattern": "*.dotx"
					},
					{
						"filenamePattern": "*.pptx"
					},
					{
						"filenamePattern": "*.pptm"
					},
					{
						"filenamePattern": "*.pdf"
					},
					{
						"filenamePattern": "*.epub"
					},
					{
						"filenamePattern": "*.ttf"
					},
					{
						"filenamePattern": "*.woff"
					},
					{
						"filenamePattern": "*.woff2"
					},
					{
						"filenamePattern": "*.otf"
					},
					{
						"filenamePattern": "*.svg"
					},
					{
						"filenamePattern": "*.icns"
					},
					{
						"filenamePattern": "*.psd"
					},
					{
						"filenamePattern": "*.xmind"
					},
					{
						"filenamePattern": "*.tiff"
					},
					{
						"filenamePattern": "*.tif"
					},
					{
						"filenamePattern": "*.heif"
					},
					{
						"filenamePattern": "*.heic"
					}
				]
			},
			{
				"viewType": "kieranDocumentStudio.archiveViewer",
				"displayName": "Kieran Document Studio: Archive Viewer",
				"selector": [
					{
						"filenamePattern": "*.jar"
					},
					{
						"filenamePattern": "*.zip"
					},
					{
						"filenamePattern": "*.7z"
					},
					{
						"filenamePattern": "*.rar"
					},
					{
						"filenamePattern": "*.tar.gz"
					},
					{
						"filenamePattern": "*.tgz"
					},
					{
						"filenamePattern": "*.tar"
					},
					{
						"filenamePattern": "*.apk"
					},
					{
						"filenamePattern": "*.vsix"
					},
					{
						"filenamePattern": "*.crx"
					}
				]
			},
			{
				"viewType": "kieranDocumentStudio.imageViewer",
				"displayName": "Kieran Document Studio: Image Preview",
				"priority": "option",
				"selector": [
					{
						"filenamePattern": "*.jpg"
					},
					{
						"filenamePattern": "*.png"
					},
					{
						"filenamePattern": "*.gif"
					},
					{
						"filenamePattern": "*.apng"
					},
					{
						"filenamePattern": "*.apng"
					},
					{
						"filenamePattern": "*.bmp"
					},
					{
						"filenamePattern": "*.ico"
					},
					{
						"filenamePattern": "*.cur"
					},
					{
						"filenamePattern": "*.jpeg"
					},
					{
						"filenamePattern": "*.pjpeg"
					},
					{
						"filenamePattern": "*.pjp"
					},
					{
						"filenamePattern": "*.webp"
					}
				]
			},
			{
				"viewType": "kieranDocumentStudio.markdownViewer",
				"displayName": "Kieran Document Studio: Markdown Editor",
				"selector": [
					{
						"filenamePattern": "file:/**/*.md"
					},
					{
						"filenamePattern": "file:/**/*.markdown"
					},
					{
						"filenamePattern": "vscode-vfs:/**/*.md"
					},
					{
						"filenamePattern": "vscode-vfs:/**/*.markdown"
					},
					{
						"filenamePattern": "vscode-remote:/**/*.md"
					},
					{
						"filenamePattern": "vscode-remote:/**/*.markdown"
					}
				]
			},
			{
				"viewType": "kieranDocumentStudio.htmlViewer",
				"displayName": "Kieran Document Studio: HTML Viewer",
				"priority": "option",
				"selector": [
					{
						"filenamePattern": "*.htm"
					},
					{
						"filenamePattern": "*.html"
					},
					{
						"filenamePattern": "*.xhtml"
					}
				]
			},
			{
				"viewType": "kieranDocumentStudio.parquetViewer",
				"displayName": "Kieran Document Studio: Parquet Viewer",
				"priority": "option",
				"selector": [
					{
						"filenamePattern": "*.parquet"
					}
				]
			},
			{
				"viewType": "kieranDocumentStudio.classViewer",
				"displayName": "Kieran Document Studio: Java Decompiler",
				"selector": [
					{
						"filenamePattern": "file:/**/*.class"
					}
				]
			},
			{
				"viewType": "kieranDocumentStudio.audioViewer",
				"displayName": "%ext.audioViewer%",
				"priority": "default",
				"selector": [
					{
						"filenamePattern": "*.{wav,WAV,wave,WAVE,mp3,MP3,flac,FLAC,ogg,OGG,oga,OGA,opus,OPUS,m4a,M4A,aac,AAC,aif,AIF,aiff,AIFF,webm,WEBM}"
					}
				]
			}
		],
		"configuration": [
			{
				"title": "Git History",
				"order": 98,
				"properties": {
					"kieran-document-studio.gitHistory.quickSyncButton": {
						"type": "boolean",
						"default": false,
						"description": "Show Quick Sync button in Source Control (Git) title toolbar."
					}
				}
			},
			{
				"title": "Markdown",
				"order": 1,
				"properties": {
					"kieran-document-studio.editorTheme": {
						"type": "string",
						"enum": [
							"Auto",
							"Light",
							"Solarized",
							"Warm Light",
							"Dim Light",
							"One Dark",
							"Github Dark",
							"Nord",
							"Monokai",
							"Dracula"
						],
						"default": "Auto",
						"markdownDescription": "The theme for the Markdown editor."
					},
					"kieran-document-studio.codeMirrorTheme": {
						"type": "string",
						"enum": [
							"Auto",
							"Github",
							"Solarized Light",
							"Material Light",
							"Quiet Light",
							"One Light",
							"Dracula",
							"Monokai",
							"One Dark",
							"Solarized Dark",
							"Material Dark"
						],
						"default": "Auto",
						"markdownDescription": "CodeMirror syntax theme for code blocks in the Markdown editor."
					},
					"kieran-document-studio.mermaidTheme": {
						"type": "string",
						"enum": [
							"Auto",
							"Light",
							"Forest",
							"Ocean",
							"Sunset",
							"Dark",
							"Dracula",
							"Monokai",
							"Nord"
						],
						"default": "Auto",
						"markdownDescription": "Mermaid diagram theme in the Markdown editor. Auto follows the editor theme."
					},
					"kieran-document-studio.editMode": {
						"type": "string",
						"enum": [
							"wysiwyg",
							"ir"
						],
						"default": "wysiwyg",
						"markdownDescription": "Default edit mode for the Markdown editor."
					},
					"kieran-document-studio.restoreViewState": {
						"type": "boolean",
						"default": true,
						"markdownDescription": "Restore caret focus when opening a Markdown file. Scroll position is always restored."
					},
					"kieran-document-studio.workspacePathAsImageBasePath": {
						"type": "boolean",
						"default": false,
						"description": "Using workspace path as markdown image base path."
					},
					"kieran-document-studio.pasteImageToWorkspacePath": {
						"type": "boolean",
						"default": false,
						"description": "Paste markdown images into the workspace path and insert image links with a leading slash."
					},
					"kieran-document-studio.pasterImgPath": {
						"type": "string",
						"default": "image/${fileName}/${now}.${ext}",
						"description": "Markdown paste image path, variables: workspaceDir, fileName, now, date (YYYYMMDD), uuid, ext (file extension)."
					}
				}
			},
			{
				"title": "Markdown PDF",
				"order": 2,
				"properties": {
					"kieran-document-studio.chromiumPath": {
						"type": "string",
						"description": "Set the chromium browser location for exporting markdown pdf."
					},
					"kieran-document-studio.puppeteerArgs": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"description": "Additional arguments to pass to Puppeteer/Chromium when exporting PDF. Example: [\"--no-sandbox\", \"--disable-setuid-sandbox\"] for Linux servers running as root."
					},
					"kieran-document-studio.pdfMarginTop": {
						"type": "integer",
						"default": 25,
						"description": "Printed pdf default top margin."
					}
				}
			},
			{
				"title": "HTTP Client",
				"order": 3,
				"properties": {
					"kieran-document-studio.followredirect": {
						"type": "boolean",
						"default": true,
						"scope": "resource",
						"description": "Follow HTTP 3xx responses as redirects."
					},
					"kieran-document-studio.environmentVariables": {
						"type": "object",
						"default": {
							"$shared": {}
						},
						"scope": "resource",
						"markdownDescription": "Sets the environments and custom variables belongs to it."
					},
					"kieran-document-studio.previewOption": {
						"type": "string",
						"enum": [
							"full",
							"headers",
							"body",
							"exchange"
						],
						"default": "body",
						"scope": "resource",
						"description": "Response preview output option"
					},
					"kieran-document-studio.previewColumn": {
						"type": "string",
						"enum": [
							"current",
							"beside"
						],
						"default": "beside",
						"scope": "resource",
						"description": "Response preview column option"
					},
					"kieran-document-studio.formParamEncodingStrategy": {
						"type": "string",
						"enum": [
							"automatic",
							"never",
							"always"
						],
						"default": "automatic",
						"scope": "resource",
						"description": "Form param encoding strategy for x-www-form-urlencoded body"
					},
					"kieran-document-studio.addRequestBodyLineIndentationAroundBrackets": {
						"type": "boolean",
						"default": true,
						"scope": "resource",
						"description": "Add line indentation around brackets in request body"
					},
					"kieran-document-studio.decodeEscapedUnicodeCharacters": {
						"type": "boolean",
						"default": false,
						"scope": "resource",
						"description": "Decode escaped unicode characters in response body."
					},
					"kieran-document-studio.logLevel": {
						"type": "string",
						"enum": [
							"error",
							"warn",
							"info",
							"verbose"
						],
						"default": "error",
						"scope": "resource",
						"description": "The verbosity of logging in the REST output panel"
					},
					"kieran-document-studio.enableCustomVariableReferencesCodeLens": {
						"type": "boolean",
						"default": true,
						"scope": "resource",
						"description": "Enable custom variable references CodeLens in request file"
					}
				}
			},
			{
				"title": "Telemetry",
				"order": 99,
				"properties": {
					"kieran-document-studio.enableTelemetry": {
						"type": "boolean",
						"default": false,
						"tags": [
							"telemetry",
							"usesOnlineServices"
						],
						"markdownDescription": "Reserved for maintainer-controlled telemetry. This community fork ships without a telemetry endpoint and sends no extension usage events, even when this setting is enabled."
					}
				}
			}
		]
	},
